@model IEnumerable<POE_CLOUD1.Models.Order>

@{
    ViewData["Title"] = "Orders Dashboard";
}

<div class="text-center mb-4">
    <h1 class="display-4 fw-bold">Orders Dashboard</h1>
    <p class="lead text-muted">This data is retrieved from Azure Table Storage</p>
    <a asp-action="Index" class="btn btn-outline-primary mt-2">
        <i class="bi bi-arrow-clockwise"></i> Refresh
    </a>
</div>


@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
{
    <div class="alert alert-danger text-center">@ViewBag.ErrorMessage</div>
}

@if (TempData["message"] != null)
{
    <div class="alert alert-success text-center">@TempData["message"]</div>
}


<div class="mb-3 text-end">
    <a asp-action="AddOrder" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add New Order
    </a>
</div>


@if (Model != null && Model.Any(o =>
        !string.IsNullOrWhiteSpace(o.OrderName) ||
        !string.IsNullOrWhiteSpace(o.OrderType) ||
        !string.IsNullOrWhiteSpace(o.OrderStatus) ||
        !string.IsNullOrWhiteSpace(o.PaymentOption)))
{
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped align-middle">
            <thead class="table-light">
                <tr class="fw-bold text-center">
                    <th>Order Name</th>
                    <th>Order Type</th>
                    <th>Status</th>
                    <th>Payment Option</th>
                    <th style="width: 180px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Where(o =>
                            !string.IsNullOrWhiteSpace(o.OrderName) ||
                            !string.IsNullOrWhiteSpace(o.OrderType) ||
                            !string.IsNullOrWhiteSpace(o.OrderStatus) ||
                            !string.IsNullOrWhiteSpace(o.PaymentOption)))
                {
                    <tr class="text-center">
                        <td>@order.OrderName</td>
                        <td>@order.OrderType</td>
                        <td>
                            <span class="badge
                                        @(order.OrderStatus == "Pending" ? "bg-warning text-dark" :
                                                                    order.OrderStatus == "Shipped" ? "bg-info text-dark" :
                                                                    order.OrderStatus == "Delivered" ? "bg-success" : "bg-secondary")">
                        @order.OrderStatus
                    </span>
                </td>
                <td>@order.PaymentOption</td>
                <td>
                    <a asp-action="Details"
                       asp-route-partitionKey="@order.PartitionKey"
                       asp-route-rowKey="@order.RowKey"
                       class="btn btn-info btn-sm me-1">Details</a>
                    <a asp-action="Edit"
                       asp-route-partitionKey="@order.PartitionKey"
                       asp-route-rowKey="@order.RowKey"
                       class="btn btn-warning btn-sm me-1">Edit</a>
                    <form asp-action="Delete" method="post" class="d-inline">
                        <input type="hidden" name="partitionKey" value="@order.PartitionKey" />
                        <input type="hidden" name="rowKey" value="@order.RowKey" />
                        <input type="hidden" name="imageUrl" value="@order.ImageUrl" />
                        <button type="submit" class="btn btn-danger btn-sm"
                                onclick="return confirm('Delete this order?')">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
                        }
            </tbody>
        </table>
    </div>
}
else
{
    <p class="fst-italic text-muted text-center mt-3">No orders found.</p>
}

<hr class="my-5" />

<!-- ================= FILE SHARE STORAGE ================= -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-secondary text-white">
        File Share Storage
    </div>
    <div class="card-body">
        <form asp-action="UploadFile" method="post" enctype="multipart/form-data">
            <div class="form-group">
                <label for="file">Choose a file to upload:</label>
                <input type="file" name="file" class="form-control" />
                <button type="submit" class="btn btn-primary mt-2">Upload</button>
            </div>
        </form>

        <h5 class="mt-3">Uploaded Files</h5>
        @if (ViewBag.LocalFiles != null && ((List<FileModel>)ViewBag.LocalFiles).Any())
        {
            <ul class="list-group mt-2">
                @foreach (var file in (List<FileModel>)ViewBag.LocalFiles)
                {
                    <li class="list-group-item">
                        @file.Name - Size: @file.DisplaySize - Last Modified: @file.LastModified?.ToString("g")
                        - <a asp-action="DownloadFile" asp-route-fileName="@file.Name">Download</a>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="fst-italic text-muted">No files found in File Share.</p>
        }
    </div>
</div>

<!-- ================= BLOB STORAGE ================= -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-primary text-white">
        Upload to Blob Storage
    </div>
    <div class="card-body">
        <form asp-action="UploadBlob" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="uploadedFile" class="form-label">Select a file to upload:</label>
                <input type="file" name="uploadedFile" id="uploadedFile" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary">Upload</button>
        </form>

        <h5 class="mt-4">Uploaded Blob Files</h5>
        @if (ViewBag.BlobFiles != null && ((List<string>)ViewBag.BlobFiles).Any())
        {
            <ul class="list-group mt-2">
                @foreach (var blobUrl in (List<string>)ViewBag.BlobFiles)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <a href="@blobUrl" target="_blank" class="text-decoration-none">
                            @System.IO.Path.GetFileName(blobUrl)
                        </a>
                        <span class="text-muted">@blobUrl</span>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="fst-italic text-muted">No files found in Blob storage.</p>
        }
    </div>
</div>

<!-- ================= QUEUE ================= -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-success text-white">
        Queue Messages
    </div>
    <div class="card-body">
        <form method="post" asp-action="Send">
            <div class="input-group mb-2">
                <input type="text" name="message" class="form-control" placeholder="Type a message..." value="" @(ViewBag.Msg != null ? "disabled" : "") />
                <button type="submit" class="btn btn-success" @(ViewBag.Msg != null ? "disabled" : "")>Send</button>
            </div>
        </form>

        @if (ViewBag.Msg != null)
        {
            <div class="alert alert-info">
                @ViewBag.Msg
            </div>
        }

        <h5>Recent Messages</h5>
        @if (ViewBag.QueueMessages != null && ((List<string>)ViewBag.QueueMessages).Count > 0)
        {
            <ul class="list-group">
                @foreach (var msg in (List<string>)ViewBag.QueueMessages)
                {
                    <li class="list-group-item">@msg</li>
                }
            </ul>
        }
        else
        {
            <p class="fst-italic text-muted">No queue messages</p>
        }
    </div>
</div>