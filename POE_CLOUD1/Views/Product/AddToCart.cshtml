@model POE_CLOUD1.CatalogProduct

@{
    ViewData["Title"] = "Add to Cart";
}

<div class="text-center mb-4">
    <h1 class="display-5">Add Product to Cart</h1>
    <p class="text-muted">Review product details before adding it to your cart.</p>
</div>

@if (TempData["msg"] != null)
{
    <div class="alert alert-success">@TempData["msg"]</div>
}

<div class="card shadow-sm mx-auto mt-3" style="max-width: 600px;">
    <div class="card-body">
        <h4 class="card-title">@Model.Name</h4>
        <p><strong>Price:</strong> @Model.Price.ToString("C")</p>

        <form asp-action="AddToCart" method="post">
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="form-group mb-3">
                <label for="qty" class="form-label"><strong>Quantity</strong></label>
                <input type="number" id="qty" name="qty" value="1" min="1" class="form-control" style="width: 120px;" />
            </div>

            <div class="d-flex justify-content-start gap-2 mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-cart-plus"></i> Add to Cart
                </button>
                <a asp-controller="Product" asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left-circle"></i> Back to Products
                </a>
            </div>
        </form>
    </div>
</div>

