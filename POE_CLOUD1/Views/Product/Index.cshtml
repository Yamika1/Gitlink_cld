@model IEnumerable<POE_CLOUD1.Models.Product>

@{
    ViewData["Title"] = "Product Dashboard";
}

<div class="text-center mb-4">
    <h1 class="display-4">Product Dashboard</h1>
    <p class="lead">Data retrieved from Azure Function & Storage</p>
    <a asp-controller="Product" asp-action="Index" class="btn btn-primary">
        <i class="bi bi-arrow-clockwise"></i> Refresh Data
    </a>
</div>

@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        @ViewBag.ErrorMessage
    </div>
}

<hr />

<!-- ================= PRODUCT LIST SECTION ================= -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-dark text-white">
        Product Catalog
    </div>
    <div class="card-body">
        @if (TempData["msg"] is string m)
        {
            <div class="alert alert-success">@m</div>
        }

        <div class="mb-3">
            <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-primary">
                <i class="bi bi-cart"></i> View Cart
            </a>
        </div>

        @if (Model != null && Model.Any())
        {
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-secondary">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Price</th>
                        <th style="width: 220px;">Quantity & Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>@p.ProductId</td>
                            <td>@p.ProductName</td>
                            <td>@p.ProductPrice</td>
                            <td>
                                <form asp-controller="Product" asp-action="AddToCart" method="post" class="d-flex align-items-center">
                                    <input type="hidden" name="id" value="@p.ProductId" />
                                    <input type="number" name="qty" value="1" min="1" class="form-control me-2" style="width:80px;" />
                                    <button type="submit" class="btn btn-sm btn-primary">
                                        <i class="bi bi-cart-plus"></i> Add
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="fst-italic text-muted">No products found.</p>
        }
    </div>
</div>

<!-- ================= FILE SHARE STORAGE ================= -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-secondary text-white">
        File Share Storage
    </div>
    <div class="card-body">
        <form asp-action="UploadFile" method="post" enctype="multipart/form-data">
            <div class="form-group">
                <label for="file">Choose a file to upload:</label>
                <input type="file" name="file" class="form-control" />
                <button type="submit" class="btn btn-primary mt-2">Upload</button>
            </div>
        </form>

        <h5 class="mt-3">Uploaded Files</h5>
        @if (ViewBag.LocalFiles != null && ((List<FileModel>)ViewBag.LocalFiles).Any())
        {
            <ul class="list-group mt-2">
                @foreach (var file in (List<FileModel>)ViewBag.LocalFiles)
                {
                    <li class="list-group-item">
                        @file.Name - Size: @file.DisplaySize - Last Modified: @file.LastModified?.ToString("g")
                        - <a asp-action="DownloadFile" asp-route-fileName="@file.Name">Download</a>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="fst-italic text-muted">No files found in File Share.</p>
        }
    </div>
</div>


<!-- ================= BLOB STORAGE ================= -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-primary text-white">
        Upload to Blob Storage
    </div>
    <div class="card-body">
        <form asp-action="UploadBlob" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="uploadedFile" class="form-label">Select a file to upload:</label>
                <input type="file" name="uploadedFile" id="uploadedFile" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary">Upload</button>
        </form>

        <h5 class="mt-4">Uploaded Blob Files</h5>
        @if (ViewBag.BlobFiles != null && ((List<string>)ViewBag.BlobFiles).Any())
        {
            <ul class="list-group mt-2">
                @foreach (var blobUrl in (List<string>)ViewBag.BlobFiles)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <a href="@blobUrl" target="_blank" class="text-decoration-none">
                            @System.IO.Path.GetFileName(blobUrl)
                        </a>
                        <span class="text-muted">@blobUrl</span>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="fst-italic text-muted">No files found in Blob storage.</p>
        }
    </div>
</div>

<!-- ================= QUEUE MESSAGES ================= -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-success text-white">
        Queue Messages
    </div>
    <div class="card-body">
        <form method="post" asp-action="Send">
            <div class="input-group mb-2">
                <input type="text" name="message" class="form-control" placeholder="Type a message..." value="" @(ViewBag.Msg != null ? "disabled" : "") />
                <button type="submit" class="btn btn-success" @(ViewBag.Msg != null ? "disabled" : "")>Send</button>
            </div>
        </form>

        @if (ViewBag.Msg != null)
        {
            <div class="alert alert-info">
                @ViewBag.Msg
            </div>
        }

        <h5>Recent Messages</h5>
        @if (ViewBag.QueueMessages != null && ((List<string>)ViewBag.QueueMessages).Count > 0)
        {
            <ul class="list-group">
                @foreach (var msg in (List<string>)ViewBag.QueueMessages)
                {
                    <li class="list-group-item">@msg</li>
                }
            </ul>
        }
        else
        {
            <p class="fst-italic text-muted">No queue messages</p>
        }
    </div>
</div>