@model IEnumerable<POE_CLOUD1.Models.Product>

@{
    ViewData["Title"] = "Product Dashboard";
}

<!-- ======= PAGE HEADER ======= -->
<div class="text-center mb-4">
    <h1 class="display-5 fw-bold">Products</h1>
    <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-primary mt-2">
        <i class="bi bi-cart"></i> View Cart
    </a>
</div>

<div class="mb-3">
    <a asp-action="AddProduct" class="btn btn-primary">Add New Product</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Product Name</th>
            <th>Description</th>
            <th>Product type</th>
           
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.ProductName</td>
                <td>@product.ProductDescription</td>
                <td>@product.ProductType</td>
      
                <td>
                    <a asp-action="Details"
                       asp-route-partitionKey="@product.PartitionKey"
                       asp-route-rowKey="@product.RowKey"
                       class="btn btn-info btn-sm">View Details</a>
                    <a asp-action="Edit"
                       asp-route-partitionKey="@product.PartitionKey"
                       asp-route-rowKey="@product.RowKey"
                       class="btn btn-primary btn-sm">Edit</a>
                    <a asp-action="Delete"
                       asp-route-partitionKey="@product.PartitionKey"
                       asp-route-rowKey="@product.RowKey"
                       class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<!-- ======= ALERTS ======= -->
@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
{
    <div class="alert alert-danger text-center">@ViewBag.ErrorMessage</div>
}

@if (TempData["msg"] is string m)
{
    <div class="alert alert-success text-center">@m</div>
}

<!-- ======= PRODUCT LIST ======= -->
@if (Model != null && Model.Any())
{
    <div class="card shadow-lg mx-auto" style="max-width: 1000px; border-radius: 12px;">
        <div class="card-body">
            <h4 class="text-center mb-3">Available Products</h4>
            <table class="table table-hover align-middle text-center">
                <thead class="table-light">
                    <tr class="fw-bold">
                        <th style="width: 60px;">ID</th>
                        <th style="width: 300px;">Name</th>
                        <th style="width: 200px;">Price</th>
                        <th style="width: 150px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>@p.ProductId</td>
                            <td>@p.ProductName</td>
                            <td>ProductPrice</td>
                            <td>
                                <form asp-controller="Product" asp-action="AddToCart" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@p.ProductId" />
                                    <button type="submit" class="btn btn-primary btn-sm px-4">
                                        Add
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <p class="fst-italic text-muted text-center mt-3">No products found.</p>
}

<hr class="my-5" />



<!-- ================= FILE SHARE STORAGE ================= -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-secondary text-white">
        File Share Storage
    </div>
    <div class="card-body">
        <form asp-action="UploadFile" method="post" enctype="multipart/form-data">
            <div class="form-group">
                <label for="file">Choose a file to upload:</label>
                <input type="file" name="file" class="form-control" />
                <button type="submit" class="btn btn-primary mt-2">Upload</button>
            </div>
        </form>

        <h5 class="mt-3">Uploaded Files</h5>
        @if (ViewBag.LocalFiles != null && ((List<FileModel>)ViewBag.LocalFiles).Any())
        {
            <ul class="list-group mt-2">
                @foreach (var file in (List<FileModel>)ViewBag.LocalFiles)
                {
                    <li class="list-group-item">
                        @file.Name - Size: @file.DisplaySize - Last Modified: @file.LastModified?.ToString("g")
                        - <a asp-action="DownloadFile" asp-route-fileName="@file.Name">Download</a>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="fst-italic text-muted">No files found in File Share.</p>
        }
    </div>
</div>


<!-- ================= BLOB STORAGE ================= -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-primary text-white">
        Upload to Blob Storage
    </div>
    <div class="card-body">
        <form asp-action="UploadBlob" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="uploadedFile" class="form-label">Select a file to upload:</label>
                <input type="file" name="uploadedFile" id="uploadedFile" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary">Upload</button>
        </form>

        <h5 class="mt-4">Uploaded Blob Files</h5>
        @if (ViewBag.BlobFiles != null && ((List<string>)ViewBag.BlobFiles).Any())
        {
            <ul class="list-group mt-2">
                @foreach (var blobUrl in (List<string>)ViewBag.BlobFiles)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <a href="@blobUrl" target="_blank" class="text-decoration-none">
                            @System.IO.Path.GetFileName(blobUrl)
                        </a>
                        <span class="text-muted">@blobUrl</span>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="fst-italic text-muted">No files found in Blob storage.</p>
        }
    </div>
</div>

<!-- ================= QUEUE MESSAGES ================= -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-success text-white">
        Queue Messages
    </div>
    <div class="card-body">
        <form method="post" asp-action="Send">
            <div class="input-group mb-2">
                <input type="text" name="message" class="form-control" placeholder="Type a message..." value="" @(ViewBag.Msg != null ? "disabled" : "") />
                <button type="submit" class="btn btn-success" @(ViewBag.Msg != null ? "disabled" : "")>Send</button>
            </div>
        </form>

        @if (ViewBag.Msg != null)
        {
            <div class="alert alert-info">
                @ViewBag.Msg
            </div>
        }

        <h5>Recent Messages</h5>
        @if (ViewBag.QueueMessages != null && ((List<string>)ViewBag.QueueMessages).Count > 0)
        {
            <ul class="list-group">
                @foreach (var msg in (List<string>)ViewBag.QueueMessages)
                {
                    <li class="list-group-item">@msg</li>
                }
            </ul>
        }
        else
        {
            <p class="fst-italic text-muted">No queue messages</p>
        }
    </div>
</div>